{
  "name": "pi-clef",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types *.test.ts ../shared/clef*.test.ts",
    "format": "prettier --write '*.ts' '*.json' '../shared/clef*.ts'",
    "lint": "prettier --check '*.ts' '*.json' '../shared/clef*.ts'"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
