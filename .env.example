# Copy to ~/.pi/agent/.env (never commit the real file).
# Read by the brave-search extension. A real environment variable of the same name wins.
BRAVE_API_KEY=

# Read by the firecrawl MCP server, which only sees real environment variables
# (pi does not load this file for MCP servers): export it from your shell profile,
# or `setx FIRECRAWL_API_KEY ...` on Windows. For a self-hosted Firecrawl any
# non-empty placeholder works. Listed here for completeness.
FIRECRAWL_API_KEY=
